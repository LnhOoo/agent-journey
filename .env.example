# 把这个文件复制一份，改名为 .env，然后填入你自己的密钥
#
# 操作：在 agent-journey 目录下执行
#     cp .env.example .env        (Git Bash / macOS / Linux)
#     copy .env.example .env      (Windows CMD)
#
# 改完 .env 后，**不要**把它提交到 GitHub —— .gitignore 已经帮你挡住了，
# 但你每次提交前还是用 `git status` 扫一眼确认没看到 .env，养成习惯。

# ===== DeepSeek（推荐，便宜、中文强、完全兼容 OpenAI 格式）=====
DEEPSEEK_API_KEY=sk-在这里填你的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 或者用阿里云百炼 / 通义千问（二选一即可）=====
# DASHSCOPE_API_KEY=sk-在这里填你的密钥
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_MODEL=qwen-plus
